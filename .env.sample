# The digitalizer's broker (k8s: kv_url.digitalizer_dev from the Key-Value note; never guess it).
BROKER=redis://localhost:6379/8
RENDER_QUEUE=evilflowers_render.standalone
# The shared storage every path in a message and a request is relative to.
STORAGE_PATH=/mnt/data
# The book's own deadline and Celery's hard kill (seconds); both under the orchestrator's 8 h.
TASK_SOFT_TIME_LIMIT=27000
TASK_TIME_LIMIT=28200
# Without veraPDF the job fails (true) or reports pdfa_valid: null (false).
VERAPDF_REQUIRED=true
LOG_FORMAT=json
LOG_LEVEL=INFO
